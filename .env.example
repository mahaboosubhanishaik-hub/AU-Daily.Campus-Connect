# Required in production
APP_ENV=production
SECRET_KEY=replace-with-a-random-64-character-secret
DATABASE_URL=mysql+pymysql://user:password@host:3306/au_daily
PUBLIC_BASE_URL=https://your-domain.example
ADMIN_ALERT_RECIPIENT=admin@your-domain.example

# Set to the exact number of trusted reverse proxies in front of the app.
TRUST_PROXY_COUNT=1

# Mail and optional services
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=mailer@your-domain.example
MAIL_PASSWORD=replace-with-an-app-password
MAIL_DEFAULT_SENDER=mailer@your-domain.example
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
GEMINI_API_KEY=

# Needed only once when bootstrapping an empty production database.
INITIAL_ADMIN_ID=replace-with-admin-id
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password
